# Copiar a .env y completar valores

# URL del backend (para rewrites de /api/* en dev)
BACKEND_URL=http://localhost:3001

# URL pública del backend (horneada en el build Dockerfile de prod)
# NEXT_PUBLIC_API_URL=http://backend:3001

# URL pública del sitio (metadatos SEO, sitemap y robots). Default: https://eduscout.cl
# NEXT_PUBLIC_SITE_URL=https://eduscout.cl
